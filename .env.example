# Copy to .env and fill in. Never commit .env.

# Required: bot token from the Discord Developer Portal (Bot tab)
DISCORD_TOKEN=
# Required for deploy-commands: Application ID (General Information tab)
CLIENT_ID=

# Optional: register commands to this one server only (instant updates while developing).
# Leave empty to register globally.
DEV_GUILD_ID=

# Optional: start the HTTP keep-alive / health endpoint on this port (Render sets PORT itself).
PORT=

# Optional: nickname the bot sets for itself in every server on startup (empty = don't rename).
BOT_NICKNAME=

# Optional: request the privileged Server Members intent (needed for welcome messages / auto-role).
# Must also be enabled in the Developer Portal → Bot → Privileged Gateway Intents. Default true.
GUILD_MEMBERS_INTENT=true

# Optional: SQLite database file (default ./data/bot.db). On a server, point this at a persistent disk.
DB_PATH=

# Optional: Lavalink audio node for music commands. Leave LAVALINK_PASSWORD empty to disable music.
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
LAVALINK_PASSWORD=
