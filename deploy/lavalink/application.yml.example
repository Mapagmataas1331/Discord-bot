# Lavalink v4 config for the Discord bot. Copy to /opt/lavalink/application.yml and
# replace __LAVALINK_PASSWORD__ with a long random secret (same value as LAVALINK_PASSWORD in the bot's .env).
server:
  port: 2333
  address: 127.0.0.1        # local only; never expose Lavalink to the internet
  http2:
    enabled: false

plugins:
  youtube:
    enabled: true
    allowSearch: true
    allowDirectVideoIds: true
    allowDirectPlaylistIds: true
    # Queried in order. MUSIC = YouTube Music search; the rest can load and play.
    clients:
      - MUSIC
      - ANDROID_VR
      - TV               # signed-in (OAuth) playback
      - WEB
      - WEBEMBEDDED
      - TVHTML5_SIMPLY
    # Local yt-cipher (yt-cipher.service) for signature solving; password = API_TOKEN in /opt/yt-cipher/env.
    # remoteCipher:
    #   url: "http://127.0.0.1:8001"
    #   password: "..."
    # If YouTube starts demanding sign-in from this server's IP, see README (OAuth with a burner account).
    # oauth:
    #   enabled: true
    #   refreshToken: "..."
    #   skipInitialization: true
  lavasrc:
    providers:
      - "ytsearch:\"%ISRC%\""
      - "ytsearch:%QUERY%"
    sources:
      spotify: false          # needs spotify.clientId/clientSecret
      applemusic: true
      deezer: false           # needs a master decryption key
    applemusic:
      countryCode: "US"
      playlistLoadLimit: 6
      albumLoadLimit: 6

lavalink:
  plugins:
    # youtube-source master snapshot with the TV-client fix (issue #226); use a release > 1.18.2 once published.
    - dependency: "dev.lavalink.youtube:youtube-plugin:2be8e542d3f6f178e048dca565892684c2e40177"
      snapshot: true
    # LavaSrc: resolves Apple Music links/search and plays them via YouTube (works without API keys).
    # Spotify needs a client ID/secret (or sp_dc cookie) and is disabled here.
    - dependency: "com.github.topi314.lavasrc:lavasrc-plugin:4.8.3"
      repository: "https://maven.lavalink.dev/releases"
      snapshot: false
  pluginsDir: "./plugins"
  server:
    password: "__LAVALINK_PASSWORD__"
    sources:
      youtube: false        # built-in source is deprecated; the youtube-plugin above replaces it
      bandcamp: true
      soundcloud: true
      twitch: true
      vimeo: true
      nico: false
      http: true            # direct audio URLs (the bot refuses private/internal addresses)
      local: false
    filters:
      volume: true
      equalizer: true
      karaoke: true
      timescale: true
      tremolo: true
      vibrato: true
      distortion: true
      rotation: true
      channelMix: true
      lowPass: true
    nonAllocatingFrameBuffer: false
    bufferDurationMs: 400
    frameBufferDurationMs: 5000
    opusEncodingQuality: 10
    resamplingQuality: LOW
    trackStuckThresholdMs: 10000
    useSeekGhosting: true
    youtubePlaylistLoadLimit: 6   # pages of 100
    playerUpdateInterval: 5
    youtubeSearchEnabled: true
    soundcloudSearchEnabled: true
    gc-warnings: true
    timeouts:                 # YouTube can be slow to answer; the 3 s default caused "Read timed out" on TVHTML5
      connectTimeoutMs: 10000
      connectionRequestTimeoutMs: 10000
      socketTimeoutMs: 10000

metrics:
  prometheus:
    enabled: false
    endpoint: /metrics

sentry:
  dsn: ""
  environment: ""

logging:
  level:
    root: INFO
    lavalink: INFO
  request:
    enabled: false
