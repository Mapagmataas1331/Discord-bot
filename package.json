{
  "name": "dc-bot",
  "version": "1.1.0",
  "description": "Community Discord bot built with discord.js v14",
  "keywords": [
    "discord",
    "bot",
    "discord.js"
  ],
  "license": "ISC",
  "author": "Mapagmataas",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm run clean && tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "node --disable-warning=ExperimentalWarning dist/index.js",
    "deploy-commands": "node dist/deploy-commands.js",
    "deploy-commands:dev": "tsx src/deploy-commands.ts"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "dotenv": "^17.2.3",
    "express": "^5.3.0",
    "lavalink-client": "^2.11.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
